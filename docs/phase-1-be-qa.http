### 12. Case test — uppercase matchMode (should still work)
POST {{baseUrl}}/scoring/matches
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "bookingId": null,
  "sportCode": "PICKLEBALL",
  "ruleSetCode": "PICKLEBALL_SIDE_OUT_11",
  "matchMode": "OPEN_PLAY",
  "gameType": "SINGLES",
  "targetScore": 11,
  "winBy": 2,
  "teams": [
    {
      "teamCode": "A",
      "teamName": "Player A",
      "players": [
        { "registeredUserId": null, "playerName": "Jessie", "isGuest": true }
      ]
    },
    {
      "teamCode": "B",
      "teamName": "Player B",
      "players": [
        { "registeredUserId": null, "playerName": "Opponent", "isGuest": true }
      ]
    }
  ]
}
